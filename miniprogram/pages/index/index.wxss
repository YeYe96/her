/** index.wxss - 深色玻璃主题 */

/* ==================== 容器 ==================== */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* ==================== 场景背景层 ==================== */
.scene-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
}

.scene-image {
  width: 100%;
  height: 100%;
  display: block;
}

.visual-filter {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* ==================== 聊天内容层 ==================== */
.chat-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  background-color: transparent; 
}

.chat-messages {
  padding: 30rpx 40rpx 40rpx;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ==================== 消息气泡 ==================== */
.message {
  margin-bottom: 30rpx;
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  max-width: 80%;
  word-wrap: break-word;
  animation: messageAppear 0.3s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

@keyframes messageAppear {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-text {
  font-size: 32rpx;
  line-height: 1.6;
}

/* 用户消息 - 绿色半透明 */
.user-message {
  align-self: flex-end;
  background-color: rgba(30, 215, 96, 0.5);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-bottom-right-radius: 4rpx;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

/* 红莉栖消息 - 深色透明 */
.amadeus-message {
  align-self: flex-start;
  background-color: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom-left-radius: 4rpx;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2);
}

.amadeus-message .message-text {
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

.message-image {
  max-width: 400rpx;
  border-radius: 10rpx;
}

/* ==================== 底部控制栏 ==================== */
.control-bar {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: transparent;
  border-top: none;
  box-sizing: border-box;
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background-image: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
}

.control-bar.panel-open {
  bottom: 0;
}

/* 图标按钮 */
.icon-btn {
  width: 80rpx; 
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 10rpx;
  flex-shrink: 0;
}

.icon {
  font-size: 56rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
  line-height: 1;
}

.icon.active {
  transform: rotate(45deg);
  transition: transform 0.2s;
}

/* 输入区域 */
.input-container {
  flex: 1;
  margin: 0 20rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.input-box {
  width: 100%;
  height: 76rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 38rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  color: #ffffff;
  caret-color: #ffffff;
  display: block;
}

.input-placeholder {
  color: rgba(255,255,255,0.5);
}

/* 发送按钮 */
.send-btn-wrapper {
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  height: 80rpx;
}

.btn-send-mini {
  background-color: rgba(30, 215, 96, 0.9);
  color: #fff;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 32rpx;
  font-weight: 600;
  width: auto !important;
  min-width: 100rpx;
  margin: 0 !important;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.2);
}

/* ==================== 拓展功能面板 ==================== */
.more-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 350rpx;
  background-color: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  z-index: 900;
  padding: 50rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
}

.panel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 60rpx;
  width: 120rpx;
}

.panel-icon {
  width: 110rpx;
  height: 110rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

.panel-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}
