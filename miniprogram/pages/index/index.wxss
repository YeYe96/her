/** index.wxss */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* ==================== 角色展示背景层 ==================== */
.character-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
}

.camera-layer {
  width: 100%;
  height: 100%;
}

.character-display {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.character-container {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.character-image {
  width: 100%;
  height: 100%;
  opacity: 0.15; /* 背景层，降低透明度 */
  filter: blur(2px);
  transition: opacity 0.3s ease, filter 0.3s ease;
}

/* 情绪叠加层（预留） */
.emotion-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* 背景渐变遮罩（让背景更柔和，聊天区域更清晰） */
.background-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.2) 30%,
    rgba(0, 0, 0, 0.3) 70%,
    rgba(0, 0, 0, 0.6) 100%
  );
  pointer-events: none;
}

/* ==================== 聊天内容层 ==================== */
.chat-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  background-color: transparent; /* 透明，显示背景 */
}

.chat-messages {
  padding: 30rpx 20rpx 20rpx;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.message {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  max-width: 75%;
  word-wrap: break-word;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  animation: messageAppear 0.3s ease;
}

@keyframes messageAppear {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

.user-message {
  background-color: rgba(0, 255, 0, 0.85);
  color: #000;
  align-self: flex-end;
  margin-left: auto;
  border-bottom-right-radius: 8rpx;
}

.amadeus-message {
  background-color: rgba(0, 34, 0, 0.9);
  color: #00ff00;
  border: 1px solid rgba(0, 255, 0, 0.3);
  align-self: flex-start;
  border-bottom-left-radius: 8rpx;
}

/* ==================== 底部控制栏（仿微信） ==================== */
.control-bar {
  min-height: 110rpx;
  display: flex;
  align-items: flex-end; /* 底部对齐，适应多行输入 */
  padding: 15rpx 20rpx;
  background-color: #f7f7f7;
  border-top: 1px solid #dcdcdc;
  box-sizing: border-box;
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  transition: bottom 0.3s ease;
}

.control-bar.panel-open {
  bottom: 0; /* 面板在下方，控制栏不需要移动，wrapper padding已撑开 */
}

/* 图标按钮 */
.icon-btn {
  width: 60rpx; /* 虽然微信图标较小，但为了触控方便 */
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 10rpx;
  flex-shrink: 0;
}

.icon {
  font-size: 56rpx;
  color: #18191a; /* 黑色图标 */
  line-height: 1;
}

.icon.active {
  transform: rotate(45deg); /* 点击+号变x号动画效果可后续添加 */
  transition: transform 0.2s;
}

/* 输入区域 */
.input-container {
  flex: 1;
  margin: 0 10rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.input-box {
  width: 100%;
  height: 72rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  color: #000;
  caret-color: #07c160; /* 微信绿光标 */
  display: block;
}

/* 语音按钮 (已移除) */


/* 发送按钮（仅输入时显示） */
.send-btn-wrapper {
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  height: 80rpx;
}

.btn-send-mini {
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 0 20rpx;
  height: 60rpx !important;
  line-height: 60rpx !important;
  border-radius: 8rpx;
  font-weight: normal;
  width: auto !important; /* 强制覆盖默认宽度 */
  min-width: 100rpx;
  margin: 0 !important;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ==================== 拓展功能面板 ==================== */
.more-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 300rpx;
  background-color: #f7f7f7;
  border-top: 1px solid #dcdcdc;
  z-index: 900;
  padding: 40rpx 50rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
}

.panel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 60rpx;
  width: 120rpx;
}

.panel-icon {
  width: 110rpx;
  height: 110rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  margin-bottom: 10rpx;
  border: 1px solid #e5e5e5;
}

.panel-text {
  font-size: 24rpx;
  color: #888;
}

/* 修改消息样式以适应浅色主题（可选，如果用户希望Amadeus保持暗黑风可保留原样，这里暂且保留原暗黑风消息框，但调整位置） */
.chat-wrapper {
  background: transparent; /* 保持透明以显示背景 */
}

/* 可以稍微调整气泡样式更像微信 */
.message {
  box-shadow: none; /* 去掉阴影更扁平 */
}

.user-message {
  background-color: #95ec69; /* 微信绿气泡 */
  color: #000;
}

.amadeus-message {
  background-color: #fff; /* 对话方白气泡 */
  color: #000;
  border: none;
}
.message-image {
  max-width: 400rpx;
  border-radius: 10rpx;
}
