.test-container {
  padding: 40rpx;
  background-color: #000;
  min-height: 100vh;
}

.title {
  display: block;
  font-size: 40rpx;
  color: #00ff00;
  text-align: center;
  margin-bottom: 60rpx;
  font-weight: bold;
}

.test-section {
  margin-bottom: 60rpx;
  padding: 30rpx;
  background-color: #1a1a1a;
  border: 2px solid #00ff00;
  border-radius: 20rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  color: #00ff00;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.simple-input,
.chat-input {
  width: 100%;
  height: 80rpx;
  background-color: #0d0d0d;
  color: #fff;
  border: 2px solid #00ff00;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.result {
  display: block;
  font-size: 28rpx;
  color: #00aa00;
  margin-top: 20rpx;
}

.test-button,
.send-button {
  width: 100%;
  height: 80rpx;
  background-color: #00ff00;
  color: #000;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.back-button {
  width: 100%;
  height: 80rpx;
  background-color: #333;
  color: #fff;
  font-size: 32rpx;
  border-radius: 10rpx;
}
